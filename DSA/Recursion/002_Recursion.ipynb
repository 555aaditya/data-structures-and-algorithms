   "source": [
    "i = 0\n",
    "\n",
    "def count() -> int:\n",
    "    global i\n",
    "    if(i==4):\n",
    "        return\n",
    "    print(i)\n",
    "    i+=1\n",
    "    count()\n",
    "\n",
    "count()"
