   ],
   "source": [
    "# it repeats the condition until the condition returns true\n",
    "\n",
    "x = \"\"\n",
    "\n",
    "while len(x) == 0:\n",
    "    x = input(\"Enter your name :\")\n",
    "\n",
    "print(f\"Hello {x}\")"
   ]
  },
